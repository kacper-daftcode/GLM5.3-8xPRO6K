# Host-specific settings for bench/*.sh on the testbed. Copy to bench/env (git-ignored); serve_full.sh / run_*.sh / soak.sh source it.
# Use the ${VAR:-default} form so that values given on the command line (e.g. MODEL=... ./serve_upstream.sh) still win.
export MODEL=${MODEL:-/path/to/models/GLM-5.3-NVFP4}              # checkpoint mounted as /model
export CACHE_ROOT=${CACHE_ROOT:-/var/cache/glm53-stack}           # torch.compile/Triton caches (one subdirectory per configuration)
export RESULTS_DIR=${RESULTS_DIR:-/path/to/results}               # soak/ablation outputs (default without this line: <repo>/results)
export PROF_DIR=${PROF_DIR:-/path/to/prof}                        # torch profiler traces (PROFILE=1); default: $RESULTS_DIR/prof
export PATCHED_DIR=${PATCHED_DIR:-/path/to/patched-vllm-files}    # run_b1s2.sh: directory with modelopt.py / deepseek_mtp.py to bind-mount over the image
# export GPUS=${GPUS:-0,1,2,3,4,5,7,8}                            # serve_full.sh: the eight RTX PRO 6000 (skip other GPUs of the host)
