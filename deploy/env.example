# Host-specific settings for deploy/*.sh. Copy to deploy/env (git-ignored); common.sh sources it automatically.
# Use the ${VAR:-default} form so that values given on the command line (e.g. MODEL_DIR=... ./serve-glm53-prod.sh) still win.
# Everything except MODEL_DIR is optional; the defaults are the reference production configuration.
export MODEL_DIR=${MODEL_DIR:-/path/to/models/GLM-5.3-NVFP4}     # ModelOpt NVFP4 checkpoint with BF16 attention/shared/MTP (incoai/GLM-5.3-NVFP4)
export CACHE_ROOT=${CACHE_ROOT:-/var/cache/glm53-stack}           # host directory for torch.compile/Triton caches; one subdirectory per configuration
export IMAGE=${IMAGE:-vllm-nightly-fi614:nvfp4-fi618}             # or glm53-stack:<date>
export CAND=${CAND:-1}                                            # candidate preset (TP4xPP2 DCP1 MTP3, 41/37, online FP8+NVFP4, threshold 512)
# export MTP=${MTP:-5} CACHE=${CACHE:-$CACHE_ROOT/vllm-fi618-cand}   # MTP5 variant (own compile cache!)
# export PP_PARTITION=41,37 LONG_PREFILL=512 MAX_SEQS=32 BATCHED=2048
# export LONG_PREFILL_DYNAMIC=${LONG_PREFILL_DYNAMIC:-4:128}      # D3 (image >= 2026.09.19-rc2): chunk 128 while more than 4 requests are active
# GPU selection: deploy/common.sh picks all "RTX PRO 6000" GPUs by UUID in nvidia-smi index order (stage 0 = first four = NUMA0).
# deploy/alert-prod.sh (cron, every minute): where findings go and optional notifier (receives the message as $1)
export ALERT_LOG=${ALERT_LOG:-/var/tmp/glm53-alerts.log}
# export ALERT_CMD=${ALERT_CMD:-/usr/local/bin/notify-slack.sh}  # e.g. curl -s -X POST -H 'Content-type: application/json' --data "{\"text\":\"$1\"}" "$WEBHOOK"
# export WAIT_MAX=2 ACC_MIN=2.6 ACC_WINDOW=60
